# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; this file is committed as a reference.

# Firebase Web SDK (public — exposed to browser)
# Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration → Config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# OpenAI (server-only — never prefix NEXT_PUBLIC_)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Site (public, used for OG tags, absolute URLs, etc.)
NEXT_PUBLIC_SITE_URL=

# ISR revalidation webhook secret (server-only)
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=
