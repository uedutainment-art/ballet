rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // User submissions (poster uploads — own folder only)
    match /submissions/{userId}/{file=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Anonymous /submit page uploads (T6a). Public write, no read — operators
    // only access via Storage Console. Spam mitigation (reCAPTCHA) lands in M5.
    match /submissions/anonymous/{file=**} {
      allow read: if false;
      allow write: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Curated posters — legacy flat path (kept for any historical objects).
    // Public read; never writable (Cloud Functions only used the structured
    // path below in practice).
    match /posters/{file} {
      allow read: if true;
      allow write: if false;
    }

    // M12-B editor uploads: posters/competitions/{docId}/* and
    // posters/performances/{docId}/*. Public read so cards/details render
    // anywhere; any authenticated user may upload (auth-gating sufficient
    // since /admin/* is editor-only and the only path that knows the docId).
    // 5MB cap — real ballet posters routinely exceed the 2MB org-logo cap.
    match /posters/{collection}/{docId}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (collection == 'competitions' || collection == 'performances')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Video thumbnails (public read; Cloud Functions write only)
    match /thumbnails/{file=**} {
      allow read: if true;
      allow write: if false;
    }

    // Organization logos (M10). Public read so they can render anywhere; any
    // authenticated user may upload. Real authorization happens at the
    // Firestore update step (only editors can attach the URL to an org doc).
    // 2MB cap, image only.
    match /organizations/{orgId}/{file=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Inquiry attachments (M11.7). Writes go through the submitInquiry
    // Cloud Function (Admin SDK). Editors read for admin review.
    match /inquiries/{inquiryId}/{file=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
