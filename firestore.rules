rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ─── Role helpers ───
    function role() {
      return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role;
    }
    function isEditor() {
      return request.auth != null && role() in ['EDITOR','ADMIN','SUPER_ADMIN'];
    }
    function isAdmin() {
      return request.auth != null && role() in ['ADMIN','SUPER_ADMIN'];
    }

    // ─── Competitions ───
    match /competitions/{id} {
      allow read: if resource.data.status == 'PUBLISHED' || isEditor();
      allow create: if isEditor()
        && request.resource.data.status in ['DRAFT','IN_REVIEW','READY'];
      allow update: if isEditor()
        && request.resource.data.status in ['DRAFT','IN_REVIEW','READY','ARCHIVED'];
      allow update: if isAdmin()
        && request.resource.data.status == 'PUBLISHED';
      allow delete: if isAdmin();
    }

    // ─── Admissions ───
    match /admissions/{id} {
      allow read: if resource.data.status == 'PUBLISHED' || isEditor();
      allow create, update: if isEditor();
      allow update: if isAdmin() && request.resource.data.status == 'PUBLISHED';
      allow delete: if isAdmin();
    }

    // ─── Videos ───
    match /videos/{id} {
      allow read: if resource.data.status == 'PUBLISHED' || isEditor();
      allow write: if isEditor();
    }

    // ─── Organizations (M10) ───
    // PUBLISHED orgs are public; everything else is editor/admin only.
    // Publishing requires admin (matches competitions/admissions pattern).
    match /organizations/{id} {
      allow read: if resource.data.workflowState == 'PUBLISHED' || isEditor();
      allow create: if isEditor()
        && request.resource.data.workflowState in ['DRAFT','IN_REVIEW','READY'];
      allow update: if isEditor()
        && request.resource.data.workflowState in ['DRAFT','IN_REVIEW','READY','ARCHIVED'];
      allow update: if isAdmin()
        && request.resource.data.workflowState == 'PUBLISHED';
      allow delete: if isAdmin();
    }

    // ─── User reports ───
    match /reports/{id} {
      allow create: if request.auth != null;
      allow read, update: if isEditor();
    }

    // ─── Users ───
    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow update: if request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      allow update: if role() == 'SUPER_ADMIN';
    }

    // ─── Edit logs ───
    // Editors append their own logs client-side. Logs are append-only; no
    // updates or deletes. Cloud Functions may also write here in T7+.
    match /editLogs/{id} {
      allow read: if isEditor();
      allow create: if isEditor()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── User submissions queue ───
    match /submissions/{id} {
      allow create: if request.auth != null;
      allow read, update: if isEditor();
      allow delete: if isAdmin();
    }

    // ─── AI extraction failures (T6a) ───
    // Cloud Functions write here via Admin SDK; editors read for triage.
    match /_failures/{id} {
      allow read: if isEditor();
      allow write: if false;
    }

    // ─── Pipeline run metadata (T6b) ───
    // _meta/lastPullRun, etc. Written by Functions; editors read for dashboard.
    match /_meta/{id} {
      allow read: if isEditor();
      allow write: if false;
    }
  }
}
